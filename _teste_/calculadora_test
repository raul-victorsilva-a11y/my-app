describe('digitarNumero', () => {
  test('substitui o zero inicial pelo número digitado', () => {
    expect(digitarNumero('0', '5', false)).toBe('5');
  });

  test('adiciona o número ao final do visor', () => {
    expect(digitarNumero('12', '3', false)).toBe('123');
  });

  test('começa um número novo depois de uma operação', () => {
    expect(digitarNumero('12', '3', true)).toBe('3');
  });

  test('começa um número novo depois de mostrar Erro', () => {
    expect(digitarNumero('Erro', '7', true)).toBe('7');
  });

  test('permite digitar zero depois de outro número', () => {
    expect(digitarNumero('10', '0', false)).toBe('100');
  });
});

describe('digitarPonto', () => {
  test('adiciona o ponto ao número atual', () => {
    expect(digitarPonto('12', false)).toBe('12.');
  });

  test('adiciona o ponto ao zero', () => {
    expect(digitarPonto('0', false)).toBe('0.');
  });

  test('não adiciona um segundo ponto', () => {
    expect(digitarPonto('1.5', false)).toBe('1.5');
  });

  test('começa com 0. quando é um número novo', () => {
    expect(digitarPonto('12', true)).toBe('0.');
  });
});

describe('calcularResultado', () => {
  test('soma', () => {
    expect(calcularResultado('2', '3', '+')).toBe('5');
  });

  test('subtrai', () => {
    expect(calcularResultado('10', '4', '-')).toBe('6');
  });

  test('subtrai com resultado negativo', () => {
    expect(calcularResultado('3', '8', '-')).toBe('-5');
  });

  test('multiplica', () => {
    expect(calcularResultado('6', '7', 'x')).toBe('42');
  });

  test('divide', () => {
    expect(calcularResultado('10', '4', '/')).toBe('2.5');
  });

  test('mostra Erro ao dividir por zero', () => {
    expect(calcularResultado('5', '0', '/')).toBe('Erro');
  });

  test('aceita números decimais', () => {
    expect(calcularResultado('1.5', '1.5', '+')).toBe('3');
  });

  test('soma decimais com margem para erro de ponto flutuante', () => {
    // 0.1 + 0.2 em JavaScript dá 0.30000000000000004
    expect(Number(calcularResultado('0.1', '0.2', '+'))).toBeCloseTo(0.3);
  });

  test('multiplicar por zero dá zero', () => {
    expect(calcularResultado('9', '0', 'x')).toBe('0');
  });
});

