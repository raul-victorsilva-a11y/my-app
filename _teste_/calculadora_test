describe('calcularHipotenusa', () => {
  test('calcula o triângulo 3-4-5', () => {
    expect(calcularHipotenusa('3', '4')).toBe('5.00');
  });

  test('calcula o triângulo 5-12-13', () => {
    expect(calcularHipotenusa('5', '12')).toBe('13.00');
  });

  test('arredonda para 2 casas decimais', () => {
    // raiz de 2 = 1.41421...
    expect(calcularHipotenusa('1', '1')).toBe('1.41');
  });

  test('aceita números decimais', () => {
    // 1.5² + 2² = 6.25 -> raiz = 2.5
    expect(calcularHipotenusa('1.5', '2')).toBe('2.50');
  });

  test('funciona quando um dos lados é zero', () => {
    expect(calcularHipotenusa('0', '7')).toBe('7.00');
  });

  test('funciona quando os dois lados são zero', () => {
    expect(calcularHipotenusa('0', '0')).toBe('0.00');
  });

  test('o resultado é o mesmo com os lados trocados', () => {
    expect(calcularHipotenusa('3', '4')).toBe(calcularHipotenusa('4', '3'));
  });

  test('retorna null quando A está vazio', () => {
    expect(calcularHipotenusa('', '4')).toBeNull();
  });

  test('retorna null quando B está vazio', () => {
    expect(calcularHipotenusa('3', '')).toBeNull();
  });

  test('retorna null quando o campo só tem espaços', () => {
    expect(calcularHipotenusa('   ', '4')).toBeNull();
  });

  test('retorna null quando não é número', () => {
    expect(calcularHipotenusa('abc', '4')).toBeNull();
    expect(calcularHipotenusa('3', 'x')).toBeNull();
  });
});