import { describe, expect, test } from '@jest/globals';
import {
  calcularBhaskara,
  calcularDelta,
  calcularHipotenusa,
  calcularRaizes,
  calcularResultado,
  digitarNumero,
  digitarPonto,
} from './funcoes';

