describe('calcularDelta', () => {
  test('calcula delta positivo', () => {
    // 1x² - 5x + 6 -> 25 - 24 = 1
    expect(calcularDelta(1, -5, 6)).toBe(1);
  });

  test('calcula delta zero', () => {
    // 1x² - 4x + 4 -> 16 - 16 = 0
    expect(calcularDelta(1, -4, 4)).toBe(0);
  });

  test('calcula delta negativo', () => {
    // 1x² + 1x + 1 -> 1 - 4 = -3
    expect(calcularDelta(1, 1, 1)).toBe(-3);
  });

  test('funciona com A negativo', () => {
    // -1x² + 0x + 4 -> 0 + 16 = 16
    expect(calcularDelta(-1, 0, 4)).toBe(16);
  });
});

describe('calcularRaizes', () => {
  test('retorna duas raízes diferentes quando delta > 0', () => {
    const [x1, x2] = calcularRaizes(1, -5, 1);
    expect(x1).toBeCloseTo(3);
    expect(x2).toBeCloseTo(2);
  });

  test('retorna duas raízes iguais quando delta = 0', () => {
    const [x1, x2] = calcularRaizes(1, -4, 0);
    expect(x1).toBeCloseTo(2);
    expect(x2).toBeCloseTo(2);
  });

  test('funciona com A negativo', () => {
    const [x1, x2] = calcularRaizes(-1, 0, 16);
    expect(x1).toBeCloseTo(-2);
    expect(x2).toBeCloseTo(2);
  });
});

describe('calcularBhaskara', () => {
  describe('validações', () => {
    test('pede para preencher quando A está vazio', () => {
      expect(calcularBhaskara('', '2', '3')).toBe('Preencha A, B e C');
    });

    test('pede para preencher quando B está vazio', () => {
      expect(calcularBhaskara('1', '', '3')).toBe('Preencha A, B e C');
    });

    test('pede para preencher quando C está vazio', () => {
      expect(calcularBhaskara('1', '2', '')).toBe('Preencha A, B e C');
    });

    test('trata campo só com espaços como vazio', () => {
      expect(calcularBhaskara('   ', '2', '3')).toBe('Preencha A, B e C');
    });

    test('recusa valores que não são números', () => {
      expect(calcularBhaskara('abc', '2', '3')).toBe('Digite apenas numeros');
      expect(calcularBhaskara('1', 'x', '3')).toBe('Digite apenas numeros');
      expect(calcularBhaskara('1', '2', '1,5')).toBe('Digite apenas numeros');
    });

    test('recusa A igual a zero', () => {
      expect(calcularBhaskara('0', '2', '3')).toBe('A nao pode ser zero');
    });
  });

  describe('delta negativo', () => {
    test('informa que não existem raízes reais', () => {
      expect(calcularBhaskara('1', '1', '1')).toBe(
        'Delta negativo: nao existem raizes reais'
      );
    });
  });

  describe('resultados', () => {
    test('delta positivo: duas raízes diferentes', () => {
      expect(calcularBhaskara('1', '-5', '6')).toBe(
        'Delta = 1\nX1 = 3\nX2 = 2'
      );
    });

    test('delta zero: duas raízes iguais', () => {
      expect(calcularBhaskara('1', '-4', '4')).toBe(
        'Delta = 0\nX1 = 2\nX2 = 2'
      );
    });

    test('A negativo', () => {
      expect(calcularBhaskara('-1', '0', '4')).toBe(
        'Delta = 16\nX1 = -2\nX2 = 2'
      );
    });

    test('números decimais', () => {
      // 0.5x² - 1.5x + 1 = 0 -> delta = 0.25, raízes 2 e 1
      expect(calcularBhaskara('0.5', '-1.5', '1')).toBe(
        'Delta = 0.25\nX1 = 2\nX2 = 1'
      );
    });

    test('B e C iguais a zero', () => {
      // x² = 0 -> raiz 0
      expect(calcularBhaskara('1', '0', '0')).toBe('Delta = 0\nX1 = 0\nX2 = 0');
    });
  });
});

